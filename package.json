{
  "name": "mimi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "npm install && stack build --system-ghc",
    "test": "npm run test:judgement && npm run test:leniency && npm run test:lyrics && npm run test:chorus",
    "setup:dev": "npm run setup && git config core.hooksPath .githooks",
    "build": "[ -f .env ] && . ./.env; stack exec --system-ghc site -- build",
    "rebuild": "[ -f .env ] && . ./.env; stack exec --system-ghc site -- rebuild",
    "watch": "[ -f .env ] && . ./.env; stack exec --system-ghc site -- watch",
    "rebuild:pages": "[ -f .env ] && . ./.env; stack exec --system-ghc site -- rebuild --path /mimi",
    "convert:osu": "npx esbuild src/tools/osu2mimi.ts --bundle --platform=node --outfile=/tmp/osu2mimi.js --log-level=silent && node /tmp/osu2mimi.js",
    "dump:lyrics": "npx --yes http-server src/tools -c-1 -o /textalive-dump.html",
    "trace:lyrics": "npx esbuild src/tools/lyrictrace.ts --bundle --platform=node --outfile=/tmp/lyrictrace.js --log-level=silent && node /tmp/lyrictrace.js",
    "build:kotaete-timings": "npx esbuild src/tools/build-kotaete-timings.ts --bundle --platform=node --outfile=/tmp/build-kotaete-timings.js --log-level=silent && node /tmp/build-kotaete-timings.js",
    "build:kotaete-lyrics": "npx esbuild src/tools/build-kotaete-lyrics.ts --bundle --platform=node --outfile=/tmp/build-kotaete-lyrics.js --log-level=silent && node /tmp/build-kotaete-lyrics.js",
    "test:judgement": "npx esbuild test/judgement.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/mimi-judgement.test.cjs --log-level=silent && node /tmp/mimi-judgement.test.cjs",
    "test:leniency": "npx esbuild test/leniency.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/mimi-leniency.test.cjs --log-level=silent && node /tmp/mimi-leniency.test.cjs",
    "test:lyrics": "npx esbuild test/lyrics.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/mimi-lyrics.test.cjs --log-level=silent && node /tmp/mimi-lyrics.test.cjs",
    "test:chorus": "npx esbuild test/chorus-timings.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/mimi-chorus.test.cjs --log-level=silent && node /tmp/mimi-chorus.test.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.1",
    "sass": "^1.86.0",
    "typescript": "^5.7.3"
  }
}
